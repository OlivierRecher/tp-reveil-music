# Port HTTP du serveur
PORT=3000
LOG_LEVEL=info
# Ordre de la chaîne de fournisseurs musicaux (le fallback local est toujours ajouté en dernier)
MUSIC_PROVIDERS=itunes,musicbrainz
# Requis par MusicBrainz : nom d'application + contact
MUSICBRAINZ_USER_AGENT=ReveilMusical/0.1.0 ( contact@example.com )
# Budget de requêtes iTunes (~20/min imposé par Apple)
ITUNES_MAX_REQUESTS_PER_MINUTE=20
MUSIC_CACHE_TTL_SECONDS=86400
MUSIC_PROVIDER_TIMEOUT_MS=2000
# Fichier où les mocks de notification écrivent leurs envois
NOTIFICATION_LOG_FILE=logs/notifications.log
# Pannes simulées pour la démo du mode dégradé (liste séparée par virgules) :
# preferences, itunes, musicbrainz, email, sms, push
# SIMULATED_FAILURES=
